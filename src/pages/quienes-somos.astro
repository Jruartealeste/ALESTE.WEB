---
import Layout from '../layouts/Layout.astro';
import { clientes } from '../data/clientes';
---

<Layout title="Quiénes somos" description="Conocé al equipo detrás de ALESTE: en qué creemos y cómo trabajamos la comunicación de nuestros clientes.">
  <section class="bg-brand px-6 py-20 text-white">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-2xl font-bold leading-snug md:text-3xl">
        Creemos que comunicar bien es tan importante como lo que se comunica.
      </p>
    </div>
  </section>

  <section class="bg-brand-dark px-6 py-20 text-white">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl font-semibold leading-snug md:text-3xl">Sobre nosotros</h2>
      <p class="mt-4 max-w-2xl text-white/80">
        Somos una agencia de comunicación 360° que trabaja junto a sus clientes desde la estrategia hasta la pieza final,
        cuidando que cada mensaje sea coherente en todos los canales.
      </p>
    </div>
  </section>

  <section class="px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl font-semibold leading-snug text-heading md:text-3xl">En qué creemos</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {[
          ['Coherencia', 'Cada pieza debe hablar el mismo idioma de marca, sin importar el canal.'],
          ['Resultados', 'La comunicación tiene que poder medirse, no solo verse bien.'],
          ['Cercanía', 'Trabajamos junto al cliente, no para el cliente.'],
        ].map(([title, text]) => (
          <div>
            <h3 class="text-lg font-bold text-heading">{title}</h3>
            <p class="mt-2 text-body">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-2xl font-semibold leading-snug text-heading md:text-3xl">Nuestro equipo</h2>
    <div class="mt-8">
      <img
        src="https://placehold.co/1200x500?text=Equipo+ALESTE"
        alt="Equipo de ALESTE"
        class="w-full rounded-2xl object-cover shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
        loading="lazy"
      />
    </div>
  </section>

  <section class="bg-white px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-2xl font-semibold leading-snug text-heading md:text-3xl">Clientes que confiaron en nosotros</h2>
      <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {clientes.map((cliente) => (
          <div class="flex items-center justify-center rounded-xl bg-black/5 p-6 transition-[transform] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5">
            <img
              src={`https://placehold.co/160x80?text=${encodeURIComponent(cliente)}`}
              alt={cliente}
              class="h-auto w-full grayscale"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <p class="text-xl font-semibold text-heading">
      Si tu marca tiene algo para decir, queremos ayudarte a decirlo bien.
    </p>
    <a
      href="/contacto"
      class="mt-7 inline-block rounded-full bg-brand px-7 py-3 text-[15px] font-medium text-white shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(247,50,1,0.55)] focus-visible:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
    >
      Hablemos
    </a>
  </section>
</Layout>

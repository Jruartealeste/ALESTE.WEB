---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaseCard from '../../components/CaseCard.astro';

const categorias = ['Todos', 'Branding', 'Campañas', 'Digital', 'Web', 'Redes', 'Institucional'] as const;

const todosLosCasos = await getCollection('casos');
const casos = todosLosCasos.sort((a, b) => a.data.orden - b.data.orden);
---

<Layout
  title="Casos"
  description="Trabajos de comunicación, branding y campañas que hicimos para nuestros clientes."
>
  <div class="bg-white">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h1 class="text-3xl font-bold text-heading">Casos</h1>
    <p class="mt-4 max-w-2xl text-body">
      Una selección de trabajos: el desafío de cada cliente, lo que hicimos y el resultado.
    </p>

    <div class="mt-8 flex flex-wrap gap-3" id="filtros" role="group" aria-label="Filtrar casos por categoría">
      {categorias.map((categoria, i) => (
        <button
          type="button"
          data-filtro={categoria}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class:list={[
            'filtro-btn rounded-full border px-5 py-2 text-sm font-medium transition-[background-color,color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0',
            i === 0
              ? 'border-brand bg-brand text-white shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)]'
              : 'border-black/10 text-body hover:border-brand hover:text-brand',
          ]}
        >
          {categoria}
        </button>
      ))}
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" id="grilla-casos">
      {casos.map((caso) => <CaseCard caso={caso} filterable />)}
    </div>
  </section>
  </div>

  <script>
    const botones = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
    const tarjetas = document.querySelectorAll<HTMLAnchorElement>('.caso-card');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro;

        botones.forEach((b) => {
          const activo = b === boton;
          b.setAttribute('aria-pressed', String(activo));
          b.classList.toggle('border-brand', activo);
          b.classList.toggle('bg-brand', activo);
          b.classList.toggle('text-white', activo);
          b.classList.toggle('shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)]', activo);
          b.classList.toggle('border-black/10', !activo);
          b.classList.toggle('text-body', !activo);
        });

        tarjetas.forEach((tarjeta) => {
          const mostrar = filtro === 'Todos' || tarjeta.dataset.categoria === filtro;
          tarjeta.classList.toggle('hidden', !mostrar);
        });
      });
    });
  </script>
</Layout>

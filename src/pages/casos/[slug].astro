---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({ params: { slug: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const { cliente, tipoTrabajo, anio, categoria, coverImage, galeria, videos, heroFocus, coverEnGaleria, coverSoloGrid } = caso.data;
const focusStyle = heroFocus ? `object-position: ${heroFocus}` : undefined;

// If there are videos, the first one is always the hero
const heroVideo = videos?.[0] ?? null;
const galleryVideos = heroVideo ? (videos?.slice(1) ?? []) : [];

// coverSoloGrid: coverImage only for the grid card — detail uses galeria[0] as hero
// coverEnGaleria: coverImage also prepended to gallery pieces (only for video cases)
const heroImg = !heroVideo
  ? (coverSoloGrid ? (galeria?.[0] ?? null) : (coverImage ?? galeria?.[0]))
  : null;
const baseGalleryImages = heroVideo
  ? (galeria ?? [])
  : coverSoloGrid
    ? (galeria?.slice(1) ?? [])
    : (coverImage ? (galeria ?? []) : (galeria?.slice(1) ?? []));
const galleryImages = (coverEnGaleria && coverImage && heroVideo) ? [coverImage, ...baseGalleryImages] : baseGalleryImages;

const hasGallery = galleryImages.length > 0 || galleryVideos.length > 0;

// Altura de compresión según ratio real del media hero:
// Para videos asumimos 16:9. Para imágenes usamos las dimensiones reales.
const heroAspectRatio = heroVideo
  ? 9 / 16
  : (heroImg?.width && heroImg?.height)
    ? heroImg.height / heroImg.width
    : 9 / 16;
const compressedHeightVw = `${(heroAspectRatio * 100).toFixed(2)}vw`;
---

<Layout title={`${cliente} — ${tipoTrabajo}`} description={`${cliente} — ${tipoTrabajo}`}>
  <div class="bg-white">

  <div id="hero-outer-mobile" class="relative h-[160vh] bg-white md:contents">
  <section id="caso-hero" class="sticky top-0 h-screen overflow-hidden bg-black" data-target-height={compressedHeightVw}>

    <!-- Media: full bleed -->
    <div id="hero-media" class="absolute inset-0">
      {heroVideo ? (
        <video
          src={heroVideo}
          class="h-full w-full object-cover"
          style={focusStyle}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        />
      ) : heroImg && (
        <Image
          src={heroImg}
          alt={`Imagen principal del caso ${cliente}`}
          width={1920}
          height={1080}
          class="h-full w-full object-cover"
          style={focusStyle}
        />
      )}
    </div>

    <!-- Overlay: se desvanece al hacer scroll -->
    <div id="hero-overlay" class="absolute inset-0 z-10 bg-black/75"></div>

    <!-- Texto: fade in place, sin movimiento vertical -->
    <div id="hero-text" class="absolute inset-x-0 top-0 z-20 px-8 pt-16 md:px-16 md:pt-20">
      <a
        href="/casos"
        class="inline-flex items-center gap-2 text-sm font-medium text-white/60 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        &larr; Volver a casos
      </a>

      <div class="mt-8 grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <p class="text-sm font-medium text-white/50">
            {anio ? `${anio} · ` : ''}{categoria}
          </p>
          <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">{cliente}</h1>
          <p class="mt-1 text-base font-medium text-brand">{tipoTrabajo}</p>
        </div>
        <div class="prose max-w-none [&_p]:text-white [&_li]:text-white [&_strong]:text-white [&_h1]:text-white [&_h2]:text-white [&_h3]:text-white [&_a]:text-white/70">
          <Content />
        </div>
      </div>
    </div>

  </section>
  </div>

  <div class="relative bg-white">

  {hasGallery && (
    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-center text-xs font-semibold uppercase tracking-widest text-placeholder">
        Piezas destacadas
      </h2>
      <div class="mt-8 flex flex-col gap-10">
        {galleryImages.map((img, i) => (
          <figure>
            <Image
              src={img}
              alt={`Pieza ${i + 1} del caso ${cliente}`}
              width={900}
              height={506}
              class="w-full rounded-xl object-cover shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              loading="lazy"
            />
          </figure>
        ))}
        {galleryVideos.map((src) => (
          <figure>
            <video
              src={src}
              class="w-full rounded-xl shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              controls
              preload="metadata"
            />
          </figure>
        ))}
      </div>
    </section>
  )}

  <div class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-col items-center gap-4 rounded-2xl bg-brand-dark px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold">¿Tenés un desafío parecido?</h2>
      <p class="max-w-md text-white/80">Hablemos de cómo podemos ayudarte a comunicarlo.</p>
      <a
        href="/contacto"
        class="mt-2 rounded-full bg-brand px-7 py-3 text-[15px] font-medium text-white shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(247,50,1,0.55)] focus-visible:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
      >
        Hablemos
      </a>
    </div>
  </div>

  </div><!-- cierra gallery wrapper -->
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const hero       = document.getElementById('caso-hero');
    const overlay    = document.getElementById('hero-overlay');
    const text       = document.getElementById('hero-text');
    const siteHeader = document.querySelector('header');

    if (hero && overlay && text) {
      const targetH = hero.getAttribute('data-target-height') ?? '56.25vw';
      const mm = gsap.matchMedia();
      const hold = { _: 0 };

      // Desktop: header+overlay+texto desaparecen al 40%, hold puro 40→70%, header vuelve 70→100%.
      mm.add('(min-width: 768px)', () => {
        const tl = gsap.timeline();
        tl.fromTo(text,       { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.3 }, 0);
        tl.fromTo(overlay,    { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.4 }, 0);
        if (siteHeader) tl.fromTo(siteHeader, { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.4 }, 0);
        tl.to(hold, { _: 1, ease: 'none', duration: 0.3 }); // hold puro 0.4→0.7
        if (siteHeader) tl.fromTo(siteHeader, { opacity: 0 }, { opacity: 1, ease: 'none', duration: 0.3, immediateRender: false }, 0.7);

        ScrollTrigger.create({
          trigger: hero,
          pin: true,
          start: 'top top',
          end: '+=100%',
          scrub: 1,
          animation: tl,
        });
      });

      // Mobile: header desaparece con overlay, reaparece al 75% (mientras galería asoma).
      mm.add('(max-width: 767px)', () => {
        const mobileOuter = document.getElementById('hero-outer-mobile');
        if (!mobileOuter) return;
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: mobileOuter,
            start: 'top top',
            end: 'bottom top',
            scrub: 1,
          }
        });
        tl.fromTo(text,       { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.25 }, 0);
        tl.fromTo(overlay,    { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.4 }, 0);
        if (siteHeader) tl.fromTo(siteHeader, { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.4 }, 0);
        tl.fromTo(hero,       { height: '100vh' }, { height: targetH, ease: 'none', duration: 0.4 }, 0.25);
        tl.to(hold,           { _: 1, ease: 'none', duration: 0.1 }); // hold puro 0.65→0.75
        if (siteHeader) tl.fromTo(siteHeader, { opacity: 0 }, { opacity: 1, ease: 'none', duration: 0.25, immediateRender: false }, 0.75);
      });
    }
  }
</script>

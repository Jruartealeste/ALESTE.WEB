---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({ params: { slug: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const { cliente, tipoTrabajo, anio, categoria, coverImage, galeria, videos } = caso.data;

// If there are videos, the first one is always the hero
const heroVideo = videos?.[0] ?? null;
const galleryVideos = heroVideo ? (videos?.slice(1) ?? []) : [];
// Image hero only when there are no videos
const heroImg = !heroVideo ? (coverImage ?? galeria?.[0]) : null;
const galleryImages = heroVideo ? (galeria ?? []) : (coverImage ? (galeria ?? []) : (galeria?.slice(1) ?? []));

const hasGallery = galleryImages.length > 0 || galleryVideos.length > 0;
---

<Layout title={`${cliente} — ${tipoTrabajo}`} description={`${cliente} — ${tipoTrabajo}`}>
  <div class="bg-white">
  <section class="mx-auto max-w-6xl px-6 py-16">
    <a
      href="/casos"
      class="inline-flex items-center gap-2 text-sm font-medium text-brand transition-[transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-x-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
    >
      &larr; Volver a casos
    </a>

    <div class="mt-8 grid gap-10 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="text-sm font-medium text-placeholder">
          {anio ? `${anio} · ` : ''}{categoria}
        </p>
        <h1 class="mt-2 text-3xl font-bold text-heading">{cliente}</h1>
        <p class="mt-1 text-base font-medium text-brand">{tipoTrabajo}</p>
      </div>
      <div class="prose prose-neutral max-w-none text-body">
        <Content />
      </div>
    </div>
  </section>

  {heroImg && (
    <div class="relative w-full overflow-hidden bg-white">
      <Image
        src={heroImg}
        alt={`Imagen principal del caso ${cliente}`}
        width={1400}
        height={630}
        class="aspect-[21/9] w-full object-cover opacity-95"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" />
    </div>
  )}

  {heroVideo && (
    <div class="relative w-full overflow-hidden bg-white">
      <video
        src={heroVideo}
        class="w-full"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      />
    </div>
  )}

  {hasGallery && (
    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-center text-xs font-semibold uppercase tracking-widest text-placeholder">
        Piezas destacadas
      </h2>
      <div class="mt-8 flex flex-col gap-10">
        {galleryImages.map((img, i) => (
          <figure>
            <Image
              src={img}
              alt={`Pieza ${i + 1} del caso ${cliente}`}
              width={900}
              height={506}
              class="w-full rounded-xl object-cover shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              loading="lazy"
            />
          </figure>
        ))}
        {galleryVideos.map((src) => (
          <figure>
            <video
              src={src}
              class="w-full rounded-xl shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              controls
              preload="metadata"
            />
          </figure>
        ))}
      </div>
    </section>
  )}

  <div class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-col items-center gap-4 rounded-2xl bg-brand-dark px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold">¿Tenés un desafío parecido?</h2>
      <p class="max-w-md text-white/80">Hablemos de cómo podemos ayudarte a comunicarlo.</p>
      <a
        href="/contacto"
        class="mt-2 rounded-full bg-brand px-7 py-3 text-[15px] font-medium text-white shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(247,50,1,0.55)] focus-visible:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
      >
        Hablemos
      </a>
    </div>
  </div>
  </div>
</Layout>

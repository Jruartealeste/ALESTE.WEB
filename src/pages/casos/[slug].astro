---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({ params: { slug: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const { cliente, tipoTrabajo, anio, categoria, coverImage, galeria, videos } = caso.data;

// If there are videos, the first one is always the hero
const heroVideo = videos?.[0] ?? null;
const galleryVideos = heroVideo ? (videos?.slice(1) ?? []) : [];
// Image hero only when there are no videos
const heroImg = !heroVideo ? (coverImage ?? galeria?.[0]) : null;
const galleryImages = heroVideo ? (galeria ?? []) : (coverImage ? (galeria ?? []) : (galeria?.slice(1) ?? []));

const hasGallery = galleryImages.length > 0 || galleryVideos.length > 0;
---

<Layout title={`${cliente} — ${tipoTrabajo}`} description={`${cliente} — ${tipoTrabajo}`}>
  <div class="bg-white">

  <!--
    Hero pinneado por GSAP (150vh de scroll).
    Texto: arriba (2 col — info + descripción), fade in place, no se mueve ("fijo").
    Media: parallax suave hacia abajo ("acompaña bajando").
    Overlay: se desvanece revelando el material en colores reales.
    Al soltar el pin: galería y CTA continúan normalmente.
  -->
  <section id="caso-hero" class="relative h-screen overflow-hidden">

    <!-- Media: full bleed, parallax suave con GSAP -->
    <div id="hero-media" class="absolute inset-0 will-change-transform">
      {heroVideo ? (
        <video
          src={heroVideo}
          class="h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        />
      ) : heroImg && (
        <Image
          src={heroImg}
          alt={`Imagen principal del caso ${cliente}`}
          width={1920}
          height={1080}
          class="h-full w-full object-cover"
        />
      )}
    </div>

    <!-- Overlay: GSAP lo desvanece al hacer scroll -->
    <div id="hero-overlay" class="absolute inset-0 z-10 bg-black/75"></div>

    <!-- Texto: queda fijo en su posición, fade in place (sin movimiento vertical) -->
    <div id="hero-text" class="absolute inset-x-0 top-0 z-20 px-8 pt-16 md:px-16 md:pt-20">
      <a
        href="/casos"
        class="inline-flex items-center gap-2 text-sm font-medium text-white/60 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        &larr; Volver a casos
      </a>

      <div class="mt-8 grid gap-10 md:grid-cols-[1fr_2fr]">
        <div>
          <p class="text-sm font-medium text-white/50">
            {anio ? `${anio} · ` : ''}{categoria}
          </p>
          <h1 class="mt-2 text-3xl font-bold text-white md:text-4xl">{cliente}</h1>
          <p class="mt-1 text-base font-medium text-brand">{tipoTrabajo}</p>
        </div>
        <div class="prose max-w-none [&_p]:text-white [&_li]:text-white [&_strong]:text-white [&_h1]:text-white [&_h2]:text-white [&_h3]:text-white [&_a]:text-white/70">
          <Content />
        </div>
      </div>
    </div>

  </section>

  {hasGallery && (
    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-center text-xs font-semibold uppercase tracking-widest text-placeholder">
        Piezas destacadas
      </h2>
      <div class="mt-8 flex flex-col gap-10">
        {galleryImages.map((img, i) => (
          <figure>
            <Image
              src={img}
              alt={`Pieza ${i + 1} del caso ${cliente}`}
              width={900}
              height={506}
              class="w-full rounded-xl object-cover shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              loading="lazy"
            />
          </figure>
        ))}
        {galleryVideos.map((src) => (
          <figure>
            <video
              src={src}
              class="w-full rounded-xl shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)]"
              controls
              preload="metadata"
            />
          </figure>
        ))}
      </div>
    </section>
  )}

  <div class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-col items-center gap-4 rounded-2xl bg-brand-dark px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold">¿Tenés un desafío parecido?</h2>
      <p class="max-w-md text-white/80">Hablemos de cómo podemos ayudarte a comunicarlo.</p>
      <a
        href="/contacto"
        class="mt-2 rounded-full bg-brand px-7 py-3 text-[15px] font-medium text-white shadow-[0_4px_14px_-2px_rgba(247,50,1,0.45)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:shadow-[0_8px_20px_-4px_rgba(247,50,1,0.55)] focus-visible:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
      >
        Hablemos
      </a>
    </div>
  </div>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const hero    = document.getElementById('caso-hero');
    const overlay = document.getElementById('hero-overlay');
    const text    = document.getElementById('hero-text');
    const media   = document.getElementById('hero-media');

    if (hero && overlay && text && media) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=150%',  // 150vh de scroll mientras el hero está pinneado
          pin: true,
          scrub: 1,
        }
      });

      // Texto: fade in place — queda fijo, no se mueve, desaparece en los primeros ~40% del scroll
      tl.fromTo(text, { opacity: 1 }, { opacity: 0, ease: 'none', duration: 0.4 }, 0);

      // Overlay: se desvanece completamente a lo largo del scroll
      tl.fromTo(overlay, { opacity: 1 }, { opacity: 0, ease: 'none' }, 0);

      // Media: parallax suave hacia abajo — "acompaña bajando"
      tl.fromTo(media, { y: '0%' }, { y: '8%', ease: 'none' }, 0);
    }
  }
</script>

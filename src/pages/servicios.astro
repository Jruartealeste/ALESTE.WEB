---
import Layout from '../layouts/Layout.astro';
import { servicios } from '../data/servicios';

const services = servicios;
---

<Layout
  title="Servicios"
  description="Comunicación 360°, identidad de marca, campañas digitales y tradicionales, diseño web y relación con formadores de opinión."
>
  <section class="bg-brand-dark px-6 py-16 text-white">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold leading-tight md:text-4xl">Lo que hacemos</h1>
      <p class="mt-4 text-base font-medium text-white/80">
        Servicios pensados para trabajar en conjunto: de la estrategia a la pieza final, sin perder de vista la marca.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article class="group relative flex flex-col gap-3 rounded-2xl border border-black/5 bg-white p-7 shadow-[0_1px_2px_rgba(0,0,0,0.04),0_12px_32px_-16px_rgba(247,50,1,0.18)] transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-1 hover:shadow-[0_4px_8px_rgba(0,0,0,0.06),0_20px_40px_-16px_rgba(247,50,1,0.28)]">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 text-brand transition-[transform] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:-translate-y-0.5">
            <img src="https://placehold.co/28x28/f73201/ffffff" alt="" class="h-7 w-7 rounded" />
          </div>
          <h2 class="border-b border-black/5 pb-[10px] text-xl font-bold text-heading">{service.title}</h2>
          <p class="text-[15px] leading-relaxed text-body">{service.bajada}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>

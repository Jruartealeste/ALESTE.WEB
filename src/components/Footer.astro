---
const year = new Date().getFullYear();

const navColumn = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Casos', href: '/casos' },
  { label: 'Quiénes somos', href: '/quienes-somos' },
];

const contactColumn = [
  { label: 'Contacto', href: '/contacto' },
  { label: 'hola@aleste.ar', href: 'mailto:hola@aleste.ar' },
  { label: '+54 9 11 0000-0000', href: 'tel:+5491100000000' },
];
---

<footer class="border-t border-black/5 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[2fr_1fr_1fr]">
      <div class="max-w-xs">
        <a
          href="/"
          class="inline-block transition-[opacity] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:opacity-70 focus-visible:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
        >
          <img src="/logo-footer.svg" alt="Aleste" class="h-16 w-auto" />
        </a>
        <p class="mt-4 text-[15px] leading-[1.7] text-body">
          Gral. Roca 3057, Oficina 201/202<br />
          Mar del Plata, Buenos Aires<br />
          Argentina
        </p>

        <div class="mt-6 flex items-center gap-5">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-placeholder transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:text-brand focus-visible:-translate-y-0.5 focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z" />
            </svg>
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-placeholder transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 hover:text-brand focus-visible:-translate-y-0.5 focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.97.24 2.43.42a4.92 4.92 0 0 1 1.78 1.16 4.92 4.92 0 0 1 1.16 1.78c.18.46.36 1.26.42 2.43.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.24 1.97-.42 2.43a4.92 4.92 0 0 1-1.16 1.78 4.92 4.92 0 0 1-1.78 1.16c-.46.18-1.26.36-2.43.42-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.97-.24-2.43-.42a4.92 4.92 0 0 1-1.78-1.16 4.92 4.92 0 0 1-1.16-1.78c-.18-.46-.36-1.26-.42-2.43C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.06-1.17.24-1.97.42-2.43a4.92 4.92 0 0 1 1.16-1.78A4.92 4.92 0 0 1 5.59 1.78c.46-.18 1.26-.36 2.43-.42C9.29 1.3 9.67 1.29 12 1.29Zm0 1.94c-3.16 0-3.51.01-4.74.07-.98.04-1.51.21-1.87.35-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.31.89-.35 1.87-.06 1.23-.07 1.58-.07 4.74s.01 3.51.07 4.74c.04.98.21 1.51.35 1.87.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.89.31 1.87.35 1.23.06 1.58.07 4.74.07s3.51-.01 4.74-.07c.98-.04 1.51-.21 1.87-.35.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.31-.89.35-1.87.06-1.23.07-1.58.07-4.74s-.01-3.51-.07-4.74c-.04-.98-.21-1.51-.35-1.87a3.04 3.04 0 0 0-.75-1.15 3.04 3.04 0 0 0-1.15-.75c-.36-.14-.89-.31-1.87-.35-1.23-.06-1.58-.07-4.74-.07Zm0 3.34a5.56 5.56 0 1 1 0 11.12 5.56 5.56 0 0 1 0-11.12Zm0 1.94a3.62 3.62 0 1 0 0 7.24 3.62 3.62 0 0 0 0-7.24Zm5.78-3.4a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="text-[15px] font-semibold text-heading">Navegación</p>
        <ul class="mt-4 flex flex-col gap-3">
          {navColumn.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[15px] text-body transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:translate-x-0.5 hover:text-brand focus-visible:translate-x-0.5 focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-x-0"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-[15px] font-semibold text-heading">Contacto</p>
        <ul class="mt-4 flex flex-col gap-3">
          {contactColumn.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[15px] text-body transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:translate-x-0.5 hover:text-brand focus-visible:translate-x-0.5 focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-x-0"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-black/5 pt-6 text-sm text-placeholder md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} ALESTE. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

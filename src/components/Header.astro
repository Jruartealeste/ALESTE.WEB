---
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Casos', href: '/casos' },
  { label: 'Quiénes somos', href: '/quienes-somos' },
  { label: 'Contacto', href: '/contacto' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-[0_1px_0_0_rgba(0,0,0,0.06),0_8px_24px_-12px_rgba(247,50,1,0.15)]">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="transition-[opacity] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:opacity-70 focus-visible:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
    >
      <img src="/logo.svg" alt="Aleste" class="h-8 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? 'page' : undefined}
          class:list={[
            'text-[15px] font-medium transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)]',
            'hover:text-brand hover:-translate-y-px focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-0',
            currentPath === item.href ? 'text-brand' : 'text-body',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger button -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex flex-col items-center justify-center gap-[5px] p-2 md:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
    >
      <span class="menu-bar block h-0.5 w-6 bg-body transition-[transform,opacity] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)]"></span>
      <span class="menu-bar block h-0.5 w-6 bg-body transition-[transform,opacity] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)]"></span>
      <span class="menu-bar block h-0.5 w-6 bg-body transition-[transform,opacity] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)]"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    aria-hidden="true"
    class="overflow-hidden md:hidden"
    style="max-height: 0; transition: max-height 0.3s cubic-bezier(0.4,0,0.2,1);"
  >
    <nav class="flex flex-col border-t border-black/6 px-6 py-4 gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? 'page' : undefined}
          class:list={[
            'py-3 text-[15px] font-medium transition-[color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)]',
            'hover:text-brand focus-visible:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand active:translate-y-px',
            currentPath === item.href ? 'text-brand' : 'text-body',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bars = toggle?.querySelectorAll('.menu-bar');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';

    if (!isOpen) {
      toggle.setAttribute('aria-expanded', 'true');
      menu!.setAttribute('aria-hidden', 'false');
      menu!.style.maxHeight = menu!.scrollHeight + 'px';
      // Animate to X
      if (bars) {
        (bars[0] as HTMLElement).style.transform = 'translateY(7px) rotate(45deg)';
        (bars[1] as HTMLElement).style.opacity = '0';
        (bars[2] as HTMLElement).style.transform = 'translateY(-7px) rotate(-45deg)';
      }
    } else {
      toggle.setAttribute('aria-expanded', 'false');
      menu!.setAttribute('aria-hidden', 'true');
      menu!.style.maxHeight = '0';
      // Animate back to bars
      if (bars) {
        (bars[0] as HTMLElement).style.transform = '';
        (bars[1] as HTMLElement).style.opacity = '';
        (bars[2] as HTMLElement).style.transform = '';
      }
    }
  });

  // Close menu on nav link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle!.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      menu.style.maxHeight = '0';
      if (bars) {
        (bars[0] as HTMLElement).style.transform = '';
        (bars[1] as HTMLElement).style.opacity = '';
        (bars[2] as HTMLElement).style.transform = '';
      }
    });
  });
</script>

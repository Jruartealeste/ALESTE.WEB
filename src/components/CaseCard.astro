---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  caso: CollectionEntry<'casos'>;
  loading?: 'lazy' | 'eager';
  filterable?: boolean;
}

const { caso, loading = 'lazy', filterable = false } = Astro.props;
const mediaSrc = caso.data.coverImage ?? caso.data.galeria?.[0];
---

<a
  href={`/casos/${caso.id}`}
  data-categoria={filterable ? caso.data.categoria : undefined}
  class:list={[
    'case-card group relative block overflow-hidden rounded-md shadow-[0_1px_2px_rgba(0,0,0,0.04),0_16px_32px_-16px_rgba(0,0,0,0.25)] transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-1 hover:shadow-[0_4px_8px_rgba(0,0,0,0.06),0_24px_40px_-16px_rgba(247,50,1,0.3)] focus-visible:-translate-y-1 focus-visible:shadow-[0_4px_8px_rgba(0,0,0,0.06),0_24px_40px_-16px_rgba(247,50,1,0.3)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand [&.is-revealed]:-translate-y-1 [&.is-revealed]:shadow-[0_4px_8px_rgba(0,0,0,0.06),0_24px_40px_-16px_rgba(247,50,1,0.3)]',
    filterable && 'caso-card',
  ]}
>
  <div class="relative aspect-[2/1] w-full overflow-hidden">
    {mediaSrc ? (
      <Image
        src={mediaSrc}
        alt={`${caso.data.cliente} — ${caso.data.tipoTrabajo}`}
        width={800}
        height={400}
        class="absolute inset-0 h-full w-full object-cover transition-[transform] duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:scale-105 group-[.is-revealed]:scale-105"
        loading={loading}
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center bg-black">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white/50" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    )}
  </div>

  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand/90 via-brand/30 to-transparent mix-blend-multiply opacity-0 transition-opacity duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:opacity-100 group-focus-visible:opacity-100 group-[.is-revealed]:opacity-100"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:opacity-100 group-focus-visible:opacity-100 group-[.is-revealed]:opacity-100"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 p-5 opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 group-[.is-revealed]:translate-y-0 group-[.is-revealed]:opacity-100"
  >
    <p class="text-lg font-bold text-white">{caso.data.cliente}</p>
    <p class="text-sm font-medium text-white/85">{caso.data.tipoTrabajo}</p>
  </div>
</a>

<script>
  function setupTapToReveal() {
    if (!window.matchMedia('(hover: none)').matches) return;

    const cards = document.querySelectorAll<HTMLAnchorElement>('a.case-card');

    cards.forEach((card) => {
      card.addEventListener('click', (event) => {
        if (card.classList.contains('is-revealed')) return;
        event.preventDefault();
        cards.forEach((c) => c.classList.remove('is-revealed'));
        card.classList.add('is-revealed');
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement).closest('a.case-card')) {
        cards.forEach((c) => c.classList.remove('is-revealed'));
      }
    });
  }

  setupTapToReveal();
</script>
